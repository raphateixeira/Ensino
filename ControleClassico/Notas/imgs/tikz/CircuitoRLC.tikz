% ---------------------------------------------------------------
% Circuito RLC série (exemplo de modelagem elétrica).
% Requer \usetikzlibrary{decorations.pathmorphing} no chunk .qmd.
% ---------------------------------------------------------------
\begin{tikzpicture}[>=Latex, line width=0.9pt]

  % fonte de tensão v(t)
  \draw (0,0.9) circle (0.35);
  \node at (0,0.9) {$v(t)$};
  \draw (0,1.25) -- (0,1.8) -- (0.9,1.8);
  \draw (0,0.55) -- (0,0.0) -- (5.5,0.0);

  % corrente i(t)
  \draw[->] (0.3,1.8) -- (0.65,1.8);
  \node[font=\small] at (0.45,2.1) {$i(t)$};

  % resistor R (zigzag manual)
  \draw (0.9,1.8) -- (1.1,1.95) -- (1.3,1.65) -- (1.5,1.95) -- (1.7,1.65) -- (1.9,1.8);
  \node[font=\small] at (1.4,2.2) {$R$};

  % indutor L
  \draw[decorate, decoration={coil, aspect=0.5, segment length=4pt, amplitude=3pt}]
    (1.9,1.8) -- (3.3,1.8);
  \node[font=\small] at (2.6,2.2) {$L$};

  % fio até o capacitor
  \draw (3.3,1.8) -- (5.5,1.8) -- (5.5,1.05);

  % capacitor C (placas paralelas)
  \draw (5.15,1.05) -- (5.85,1.05);
  \draw (5.15,0.75) -- (5.85,0.75);
  \draw (5.5,0.75) -- (5.5,0.0);
  \node[font=\small] at (6.25,0.9) {$C$};

  % tensão de saída v_C(t)
  \draw[->] (6.6,1.05) -- (6.6,0.75);
  \node[font=\small] at (7.35,0.9) {$v_C(t)$};

\end{tikzpicture}
