{
    "text-color": "#1D1C1A",
    "background-color": "#EFEBE3",
    "line-number-color": "#B3AD9F",
    "line-number-background-color": null,
    "text-styles": {
        "Keyword":        { "text-color": "#1B365D", "bold": true },
        "ControlFlow":    { "text-color": "#1B365D", "bold": true },
        "Import":         { "text-color": "#1B365D", "bold": true },
        "DataType":       { "text-color": "#1B365D" },
        "BuiltIn":        { "text-color": "#3D63A8" },
        "Function":       { "text-color": "#3D63A8" },
        "Extension":      { "text-color": "#3D63A8" },
        "Attribute":      { "text-color": "#3D63A8" },
        "String":         { "text-color": "#A63D4A" },
        "VerbatimString": { "text-color": "#A63D4A" },
        "SpecialString":  { "text-color": "#A63D4A" },
        "Char":           { "text-color": "#A63D4A" },
        "SpecialChar":    { "text-color": "#A63D4A" },
        "DecVal":         { "text-color": "#2E7D4F" },
        "BaseN":          { "text-color": "#2E7D4F" },
        "Float":          { "text-color": "#2E7D4F" },
        "Constant":       { "text-color": "#2E7D4F" },
        "Comment":        { "text-color": "#8A857B", "italic": true },
        "Documentation":  { "text-color": "#8A857B", "italic": true },
        "CommentVar":     { "text-color": "#8A857B", "italic": true },
        "Annotation":     { "text-color": "#8A857B", "italic": true },
        "Operator":       { "text-color": "#1D1C1A" },
        "Variable":       { "text-color": "#1D1C1A" },
        "Other":          { "text-color": "#1D1C1A" },
        "Preprocessor":   { "text-color": "#96263A" },
        "Information":    { "text-color": "#C99A2E" },
        "Warning":        { "text-color": "#C99A2E", "bold": true },
        "Alert":          { "text-color": "#96263A", "bold": true },
        "Error":          { "text-color": "#96263A", "bold": true }
    }
}
