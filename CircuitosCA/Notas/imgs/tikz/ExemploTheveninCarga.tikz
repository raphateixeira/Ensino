% ---------------------------------------------------------------------
% Equivalente de Thévenin do exemplo resolvido com a carga RL = 5 Ω.
% Requer circuitikz.
% ---------------------------------------------------------------------
\ctikzset{bipoles/length=1.7cm}
\begin{circuitikz}[scale=1.85, line width=1.5pt, font=\Large]
\draw (0,0) to[sinusoidal voltage source, l=$\mathbf{V}_{th}$] (0,3)
  to[R, l={$\mathbf{Z}_{th} = 5~\Omega$}, i>_=$\mathbf{I}_L$] (3.8,3)
  to[R, l_={$R_L = 5~\Omega$}] (3.8,0) -- (0,0);
\draw (3.8,3) node[circle, fill=black, inner sep=1.6pt]{} node[above right]{$a$};
\draw (3.8,0) node[circle, fill=black, inner sep=1.6pt]{} node[below right]{$b$};
\node at (0.45,2.1) {$+$};
\node at (0.45,0.9) {$-$};
\end{circuitikz}
